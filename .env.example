# Variables serveur UNIQUEMENT — ne jamais préfixer par NEXT_PUBLIC_.
# Voir docs/02-MODELS-AI-SDK.md §6.

# Meta Model API (https://api.meta.ai/v1)
MODEL_API_KEY=
META_SPARK_MODEL=muse-spark-1.3
META_WONDER_MODEL=muse-wonder-1.0

# OpenAI (modèle principal figé après benchmark M0)
OPENAI_API_KEY=
OPENAI_MAIN_MODEL=

# Modèle par défaut d'un run : meta-spark | meta-wonder | openai-main
DEFAULT_MODEL=meta-spark

# Garde-fous boucle agent (doc 02 §5, doc 03)
AGENT_MAX_STEPS=50
AGENT_RUN_BUDGET_USD=

# Tests internes UNIQUEMENT : autorise les variantes -contributor (données
# synthétiques). Laisser vide/0 pour tout usage avec projets utilisateur.
NIATOLIP_ALLOW_CONTRIBUTOR=
